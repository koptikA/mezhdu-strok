                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "3. Форма без состояний.",
                  "lineHeight": 1.4,
                  "fontFamily": "Golos Text",
                  "fontSize": 16,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "ZRzHP",
