          "padding": 22,
          "children": [
            {
              "type": "text",
              "id": "K0BnY",
              "fill": "#e8e6ee",
              "content": "Чего в брифе нет, но спросят",
              "fontFamily": "Literata",
              "fontSize": 22,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "oZCA8",
              "fill": "#e8e6ee",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Объяснить выбор структуры — М2 · «на твой вкус» значит, что судить будут ход мысли.\nПоказать состояния формы — М5 · форма названа прямо, она и есть предмет проверки.\nТаблица конкурентов с выводом — М3 · сбор без вывода не засчитывается.",
              "lineHeight": 1.6,
              "fontFamily": "Golos Text",
              "fontSize": 15.5,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "FrOnG",
          "name": "Раздел — Как это будут оценивать",
          "width": "fill_container",
          "fill": "#17161c",
          "cornerRadius": 14,
