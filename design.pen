              "gap": 4,
              "children": [
                {
                  "type": "text",
                  "id": "LCSEe",
                  "fill": "#e8e6ee",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "3. Чужая айдентика внутри страницы про уникальность услуги.",
                  "lineHeight": 1.4,
                  "fontFamily": "Golos Text",
                  "fontSize": 16,
