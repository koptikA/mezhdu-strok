            },
            {
              "type": "text",
              "id": "jtvpE",
              "fill": "#e8e6ee",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Разведка конкурентов 4–6 ч, структура 6–8 ч, макеты 14–20 ч, состояния и адаптив 6–8 ч, подача 4 ч. Итого 34–46 часов. При сроке в неделю и параллельной работе это не влезает.",
              "lineHeight": 1.6,
              "fontFamily": "Golos Text",
              "fontSize": 15.5,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "Mhspo",
          "name": "Раздел — Что просят буквально",
          "width": "fill_container",
          "fill": "#17161c",
          "cornerRadius": 14,
          "stroke": "#2a2833",
          "strokeWidth": 1,
          "layout": "vertical",
          "gap": 10,
          "padding": 22,
          "children": [
            {
              "type": "text",
              "id": "fEisl",
              "fill": "#e8e6ee",
              "content": "Что просят буквально",
              "fontFamily": "Literata",
              "fontSize": 22,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "SEtbZ",
              "fill": "#e8e6ee",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Один экран лендинга. Форма записи на пробный урок. Адаптив под телефон. Ориентир — сайты конкурентов.",
              "lineHeight": 1.6,
              "fontFamily": "Golos Text",
              "fontSize": 15.5,
              "fontWeight": "normal"
            }
          ]
        },
        {
