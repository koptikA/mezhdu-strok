                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Вся суть задания — форма записи. Если она нарисована в одном виде, вывод будет: дизайнер интерфейсов из вас пока не получается, картинки рисуете.",
                  "lineHeight": 1.55,
                  "fontFamily": "Golos Text",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            }
