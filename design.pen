                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Смысловое противоречие, которое видно без всякой экспертизы, плюс вопрос о правах на иллюстрации.",
                  "lineHeight": 1.55,
                  "fontFamily": "Golos Text",
