          "children": [
            {
              "type": "text",
              "id": "bXlKx",
              "fill": "#e8e6ee",
              "content": "Как это будут оценивать",
              "fontFamily": "Literata",
              "fontSize": 22,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "w9M2On",
              "fill": "#e8e6ee",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Смотреть будет дизайнер, а не маркетолог: связность решения важнее красоты отдельных блоков. Проверят, объяснено ли, почему блоки идут в таком порядке.",
              "lineHeight": 1.6,
              "fontFamily": "Golos Text",
              "fontSize": 15.5,
              "fontWeight": "normal"
            }
          ]
        },
